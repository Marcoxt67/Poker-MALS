// Poker MALS - Virtual chips poker table simulator
// SQLite for development. Structured so the datasource can be swapped to PostgreSQL later
// by changing `provider` + `url` below. Enum-like fields use String on purpose because
// SQLite has no native enum support in Prisma; valid values are enforced in the TS layer
// (see server/src/utils/enums.ts) and can become real `enum` blocks once on PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  displayName  String
  email        String   @unique
  passwordHash String
  avatar       String?
  chips        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tablePlayers        TablePlayer[]
  chipTransactions    ChipTransaction[] @relation("UserTransactions")
  createdTransactions ChipTransaction[] @relation("CreatedByUser")
  actions             Action[]
  tablesCreated       Table[]           @relation("TableCreator")
  wonRounds           Round[]           @relation("RoundWinner")

  @@map("users")
}

/// TableStatus: AGUARDANDO | EM_ANDAMENTO | FINALIZANDO | FINALIZADA | PAUSADA
model Table {
  id                 String   @id @default(uuid())
  name               String
  code               String   @unique
  maxPlayers         Int      @default(8)
  minBuyIn           Int      @default(20)
  startingChips      Int      @default(100)
  status             String   @default("AGUARDANDO")
  tableType          String   @default("CASH")
  createdById        String
  createdBy          User     @relation("TableCreator", fields: [createdById], references: [id])
  currentRoundNumber Int      @default(0)
  actionTimerSeconds Int      @default(30)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  players          TablePlayer[]
  rounds           Round[]
  chipTransactions ChipTransaction[]
  actions          Action[]

  @@map("tables")
}

/// TablePlayerRole: DIRE | PLAYER
/// TablePlayerStatus: ACTIVE | LEFT | REMOVED
model TablePlayer {
  id        String   @id @default(uuid())
  tableId   String
  table     Table    @relation(fields: [tableId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   @default("PLAYER")
  chips     Int      @default(0)
  status    String   @default("ACTIVE")
  seatOrder Int      @default(0)
  joinedAt  DateTime @default(now())

  roundPlayers RoundPlayer[]

  @@unique([tableId, userId])
  @@map("table_players")
}

/// RoundStatus: EM_ANDAMENTO | FINALIZADA
model Round {
  id          String    @id @default(uuid())
  tableId     String
  table       Table     @relation(fields: [tableId], references: [id])
  roundNumber Int
  status      String    @default("EM_ANDAMENTO")
  potTotal    Int       @default(0)
  currentBet  Int       @default(0)
  turnUserId  String?
  winnerId    String?
  winner      User?     @relation("RoundWinner", fields: [winnerId], references: [id])
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  roundPlayers     RoundPlayer[]
  actions          Action[]
  chipTransactions ChipTransaction[]

  @@map("rounds")
}

/// RoundPlayerStatus: ACTIVE | FOLDED
model RoundPlayer {
  id            String @id @default(uuid())
  roundId       String
  round         Round  @relation(fields: [roundId], references: [id])
  tablePlayerId String
  tablePlayer   TablePlayer @relation(fields: [tablePlayerId], references: [id])
  contributed   Int    @default(0)
  status        String @default("ACTIVE")
  seatOrder     Int    @default(0)

  @@unique([roundId, tablePlayerId])
  @@map("round_players")
}

/// ChipTransactionType: ADMIN_ADD | ADMIN_REMOVE | BUY_IN | BET | CALL | RAISE | POT_WIN | REFUND
model ChipTransaction {
  id          String   @id @default(uuid())
  tableId     String
  table       Table    @relation(fields: [tableId], references: [id])
  userId      String
  user        User     @relation("UserTransactions", fields: [userId], references: [id])
  roundId     String?
  round       Round?   @relation(fields: [roundId], references: [id])
  type        String
  amount      Int
  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("CreatedByUser", fields: [createdById], references: [id])
  description String?

  @@map("chip_transactions")
}

/// ActionType: JOIN | LEAVE | START_ROUND | BET | CALL | RAISE | FOLD | WINNER_SELECTED
///           | PAUSE_TABLE | RESUME_TABLE | END_ROUND | ADMIN_ADD_CHIPS | ADMIN_REMOVE_CHIPS
///           | ADMIN_REMOVE_PLAYER
model Action {
  id          String   @id @default(uuid())
  tableId     String
  table       Table    @relation(fields: [tableId], references: [id])
  roundId     String?
  round       Round?   @relation(fields: [roundId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  type        String
  amount      Int?
  description String
  createdAt   DateTime @default(now())

  @@map("actions")
}
