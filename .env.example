# ---- Server ----
# SQLite for development. To migrate later, change to a PostgreSQL connection
# string (e.g. postgresql://user:pass@host:5432/db) and switch the
# `provider` in prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Port the Express + Socket.IO server listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API / connect via Socket.IO.
CORS_ORIGIN="http://localhost:5173"

# Default number of virtual chips a brand-new user starts with (profile wallet, cosmetic only).
DEFAULT_USER_CHIPS=1000

# ---- Client ----
# Base URL of the backend API used by the Vite dev server / build.
VITE_API_URL="http://localhost:4000"
VITE_SOCKET_URL="http://localhost:4000"
