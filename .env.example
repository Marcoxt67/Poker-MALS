# ---- Servidor ----
# Segredo usado para assinar os JWTs. Use um valor longo e aleatório.
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Porta do servidor Express + Socket.IO. No Render isso é injetado automaticamente.
PORT=4000

# Origens permitidas para chamadas de API / Socket.IO. Em deploy de serviço único
# (backend servindo o frontend) isso não é usado, pois tudo fica na mesma origem.
CORS_ORIGIN="http://localhost:5173"

# Fichas iniciais da carteira de um usuário recém-cadastrado (exibição no dashboard).
DEFAULT_USER_CHIPS=1000

# ---- Firebase (Realtime Database) ----
# ATENÇÃO: estes valores NÃO são segredos. A config web do Firebase é pública por
# design: ela identifica o projeto, não autentica quem chama. O que protege os
# dados são as regras do Realtime Database. Veja a seção de segurança no README.
#
# O código já traz estes valores como padrão, então em deploy você só precisa
# defini-los se for usar OUTRO projeto Firebase.
FIREBASE_API_KEY="AIzaSyBjCzzw9bI2LT-wjtZAYuM-0HaiqFqh7MA"
FIREBASE_AUTH_DOMAIN="poker-326a4.firebaseapp.com"
FIREBASE_PROJECT_ID="poker-326a4"
FIREBASE_STORAGE_BUCKET="poker-326a4.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="184822227116"
FIREBASE_APP_ID="1:184822227116:web:624df4eac1c4cb1e9ebf09"
FIREBASE_MEASUREMENT_ID="G-3CTD5HG9L1"

# URL do Realtime Database. NÃO vem no snippet de config do console — depende da
# região onde o banco foi criado. Confira em Firebase Console > Realtime Database.
#   us-central1:     https://<projeto>-default-rtdb.firebaseio.com
#   outras regiões:  https://<projeto>-default-rtdb.<regiao>.firebasedatabase.app
FIREBASE_DATABASE_URL="https://poker-326a4-default-rtdb.firebaseio.com"

# Quando definido, o servidor fala com o emulador local em vez do projeto real.
# Deixe VAZIO em produção. Para desenvolver offline: 127.0.0.1:9000
FIREBASE_DATABASE_EMULATOR_HOST=""

# ---- Cliente ----
# Deixe vazio/ausente quando o backend servir o frontend (mesma origem).
# Só preencha se o frontend for hospedado separado do backend.
VITE_API_URL=""
VITE_SOCKET_URL=""
